{
    "manifest_version": 3,
    "name": "Clear Data for Current Site",
    "version": "2.0.0",
    "minimum_chrome_version": "96",
    "description": "Clears browser data for the current site only.",
    "author": "Nicolas Barraud",

      "permissions": [
    "browsingData",
    "tabs",
    "activeTab",
    "scripting"
  ],

    "options_ui":
    {
        "page": "src/options/options.html",
        "open_in_tab": false
    },

    "commands":
    {
        "_execute_action":
        {
            "suggested_key":
            {
                "default": "Ctrl+Shift+Y",
                "mac": "Command+Shift+Y"
            }
        }
    },

    "icons":
    {
        "16": "assets/icons/icon16.png",
        "32": "assets/icons/icon32.png",
        "64": "assets/icons/icon64.png",
        "128": "assets/icons/icon128.png"
    },

    "action":
    {
        "default_title": "Clear Data for Current Site",

        "default_popup": "src/popup/popup.html",

        "default_icon":
        {
            "16": "assets/icons/icon16.png",
            "24": "assets/icons/icon24.png",
            "32": "assets/icons/icon32.png",
            "64": "assets/icons/icon64.png",
            "128": "assets/icons/icon128.png"
        }
    },

    "background":
    {
        "service_worker": "src/background/service-worker.js"
    }
}
